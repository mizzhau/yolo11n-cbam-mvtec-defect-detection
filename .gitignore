# ============================================================
# .gitignore — Python / PyTorch / YOLO / KLCN-2026
# ============================================================

# === Python ===
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
build/

# === Virtual Environment ===
.venv/
venv/
ENV/

# === IDE ===
.vscode/
.idea/
*.swp
*.swo
*~

# === OS ===
.DS_Store
Thumbs.db
desktop.ini

# === Jupyter Notebook checkpoints ===
.ipynb_checkpoints/

# === Dữ liệu gốc, trung gian & đã xử lý (quá lớn cho Git, lưu trữ qua Drive/Zip) ===
/data/

# === Model weights, runs & experiment outputs ===
runs/
experiments/*
!experiments/testing/
artifacts/

# === File nén dữ liệu ===
*.tar.xz
*.tar.gz
*.zip
*.bin
*.7z
*.rar

# === Các file nhị phân lớn khác ===
*.onnx
*.engine
*.tflite

# === Không push theo yêu ===
tests/
docs/
AGENTS.md
.geminiignore
.pytest_cache/
